generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   // HTML content generated by WYSIWYG
  targetType  String   // "ALL", "DEPARTMENT", "BRANCH", "USERS", "AUDIENCE"
  targetIds   String[] // Array of IDs if applicable (department IDs, branch IDs, user IDs, or audience IDs)
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, PUBLISHED
  scheduledAt DateTime?
  template    String   @default("STANDARD") // STANDARD or ALERT
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedAudience {
  id        String   @id @default(cuid())
  name      String   @unique
  members   String[] // Array of Identity User UUIDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
